{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devhub-404-purge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "services": [
    {
      "binding": "API",
      "service": "devhub-404-api"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
