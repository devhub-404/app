{
  "name": "@devhub-404/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env.development node_modules/astro/bin/astro.mjs dev --ignore-lock",
    "dev:test": "node --env-file=../../.env.test node_modules/astro/bin/astro.mjs dev --port 4322 --ignore-lock",
    "build": "pnpm run types && astro check && astro build",
    "start": "pnpm build && node ../../scripts/wait-for-api.mjs http://127.0.0.1:8080/api/v1/platform/readiness && wrangler dev --local --env-file ../../.env.development --var APP_ENV:development --var API_URL:http://127.0.0.1:8080 --var WEB_URL:http://localhost:4321 --var HSTS_ENABLED:false --port 4321 --persist-to ../../.local/wrangler-web-development",
    "check": "pnpm run types && astro check",
    "preview": "astro preview",
    "types": "wrangler types worker-configuration.d.ts",
    "typecheck": "astro check",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.39.2",
    "@modular-forms/solid": "^0.25.1",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/solid": "^1.1.1",
    "@serenity-kit/opaque": "^1.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@utilify/core": "^2.0.5",
    "diff-match-patch": "^1.0.5",
    "indexeddb-promisify": "^1.0.0",
    "jose": "^6.2.12",
    "lowlight": "^3.3.0",
    "lucide-solid": "^1.47.0",
    "nanostores": "^1.5.3",
    "openapi-fetch": "^0.17.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.15",
    "zod": "^4.6.5",
    "@devhub-404/api-contract": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/solid-js": "^7.0.2",
    "@iconify-json/lucide": "^1.2.134",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@cloudflare/workers-types": "^5.20260919.1",
    "astro": "^7.3.3",
    "astro-icon": "^1.2.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "vitest": "^5.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.135.0"
  }
}
