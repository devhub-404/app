---
import { ContributionPage } from '@/features/home/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate, type TranslationKey } from '@/features/home/i18n';

const t = (key: TranslationKey) => translate(Astro.locals.locale, key);
---

<AppLayout title={t('contribute.metaTitle')} description={t('contribute.metaDescription')} keywords={t('contribute.metaKeywords')}>
  <ContributionPage />
</AppLayout>
