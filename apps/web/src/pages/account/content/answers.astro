---
import { AccountAnswersPage as AnswersPage } from '@/features/account/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate as translateApp } from '@/shared/i18n/app';

const locale = Astro.locals.locale;
---

<AppLayout title={translateApp(locale, 'answers.answers')} description={translateApp(locale, 'answers.answersCreatedByAccount')} keywords="answers">
  <AnswersPage />
</AppLayout>
