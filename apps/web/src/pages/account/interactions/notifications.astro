---
import { AccountNotificationsPageRoute as NotificationsPage } from '@/features/account/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate as translateI18n } from '@/shared/i18n/app';

const locale = Astro.locals.locale;
---

<AppLayout title={translateI18n(locale, 'notifications.devhubNotifications')} description={translateI18n(locale, 'notifications.notificationsAccount')} keywords="devhub,notifications,account">
  <NotificationsPage />
</AppLayout>
