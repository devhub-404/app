---
import { AccountVotesPageRoute as VotesPage } from '@/features/account/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate as translateI18n } from '@/shared/i18n/app';

const locale = Astro.locals.locale;
---

<AppLayout title={translateI18n(locale, 'votes.devhubVotes')} description={translateI18n(locale, 'votes.votesAccount')} keywords="devhub,votes,account">
  <VotesPage />
</AppLayout>
