---
import { AccountResourceSuggestionsPage as ResourceSuggestionsPage } from '@/features/account/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate as translateI18n } from '@/shared/i18n/app';

const locale = Astro.locals.locale;
---

<AppLayout title={translateI18n(locale, 'resources.devhubResourceSuggestions')} description={translateI18n(locale, 'resources.suggestionsResourcesAssociatedAccount')} keywords="devhub,resources,suggestions">
  <ResourceSuggestionsPage />
</AppLayout>
