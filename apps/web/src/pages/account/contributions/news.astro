---
import { AccountNewsSuggestionsPage as NewsSuggestionsPage } from '@/features/account/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate as translateI18n } from '@/shared/i18n/app';

const locale = Astro.locals.locale;
---

<AppLayout title={translateI18n(locale, 'news.devhubMySuggestionsNews')} description={translateI18n(locale, 'news.suggestionsNewsAssociatedAccount')} keywords="devhub,news,suggestions,contributions">
  <NewsSuggestionsPage />
</AppLayout>
