import { translate as translateI18n } from '@/shared/i18n/app';

const locale = Astro.locals.locale;
---

<AppLayout title={translateI18n(locale, 'events.devhubEventSuggestions')} description={translateI18n(locale, 'events.suggestionsEventsAssociatedAccount')} keywords="devhub,events,suggestions">
  <EventSuggestionsPage />
</AppLayout>
