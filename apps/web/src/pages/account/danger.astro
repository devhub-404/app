---
import { SettingsSectionPage } from '@/features/account/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate } from '@/features/account/i18n';

const locale = Astro.locals.locale;
---

<AppLayout title={translate(locale, 'profilesettings.devHubSettings')} description={translate(locale, 'profilesettings.manageSettingsDevHub')} keywords={translate(locale, 'accountsettings.dangerKeywords')}>
  <SettingsSectionPage section="danger" />
</AppLayout>
