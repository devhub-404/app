---
import { AccountPreferencesPage } from '@/features/account/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate, type TranslationKey } from '@/features/account/i18n';

const t = (key: TranslationKey) => translate(Astro.locals.locale, key);
---

<AppLayout title={`Dev Hub - ${t('account.preferences')}`} description={t('preferences.description')} keywords="devhub,account,preferences">
  <AccountPreferencesPage />
</AppLayout>
