---
import { PublicProfilePage } from '@/features/account/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate } from '@/features/account/i18n';

const username = Astro.params['username'] ?? '';
const locale = Astro.locals.locale;
---

<AppLayout title={`Dev Hub - @${username}`} description={translate(locale, 'publicprofile.profilePublic')} keywords="devhub,profile,public">
  <PublicProfilePage {username} />
</AppLayout>
