---
import { getCollection } from 'astro:content';
import { CodexEntryPage } from '@/features/codex/public';
import { selectLocalizedEntries } from '@/shared/content/localized-entries';
import AppLayout from '@/app/ui/AppLayout.astro';

const entries = selectLocalizedEntries(
  await getCollection('codex', ({ data }) => data.status === 'published'),
  Astro.locals.locale,
);
const entry = entries.find((item) => item.data.slug === (Astro.params['slug'] ?? ''));
if (!entry) return Astro.redirect('/404');
---

<AppLayout
  title={`DevHub - ${entry.data.title}`}
  description={entry.data.description}
  keywords={`devhub,codex,${entry.data.tags.join(',')}`}
  codexBase={entry.data.branding.color}
>
  <CodexEntryPage entry={entry} entries={entries} />
</AppLayout>
