import AppLayout from '@/app/ui/AppLayout.astro';
import { translate } from '@/features/auth/i18n';

const locale = Astro.locals.locale;
---

<AppLayout title={`DevHub - ${translate(locale, 'page.recoveryTitle')}`} description={translate(locale, 'page.recoverySubtitle')} keywords="devhub,auth">
  <AccountRecoveryPage />
</AppLayout>
