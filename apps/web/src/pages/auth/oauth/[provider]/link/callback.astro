---
import { OAuthLinkCallbackPage } from '@/features/auth/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate } from '@/features/auth/i18n';

const locale = Astro.locals.locale;
---

<AppLayout title={`DevHub - ${translate(locale, 'page.oauthLinkTitle')}`} description={translate(locale, 'page.oauthLinkSubtitle')} keywords="devhub,auth">
  <OAuthLinkCallbackPage />
</AppLayout>
