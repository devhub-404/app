---
import { OAuthCallbackPage } from '@/features/auth/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate } from '@/features/auth/i18n';

const locale = Astro.locals.locale;
---

<AppLayout title={`DevHub - ${translate(locale, 'page.oauthTitle')}`} description={translate(locale, 'page.oauthSubtitle')} keywords="devhub,auth">
  <OAuthCallbackPage />
</AppLayout>
