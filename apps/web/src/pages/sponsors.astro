---
import { SponsorsPage } from '@/features/home/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate } from '@/features/home/i18n';

const locale = Astro.locals.locale;
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
---

<AppLayout title={t('support.metaTitle')} description={t('support.metaDescription')} keywords={t('support.metaKeywords')}>
  <SponsorsPage />
</AppLayout>
