---
import { SignInPage } from '@/features/auth/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate } from '@/features/auth/i18n';

const locale = Astro.locals.locale;
---

<AppLayout title={`DevHub - ${translate(locale, 'page.signInTitle')}`} description={translate(locale, 'page.signInSubtitle')} keywords="devhub,auth">
  <SignInPage />
</AppLayout>
