---
import { ForgotPasswordPage } from '@/features/auth/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate } from '@/features/auth/i18n';

const locale = Astro.locals.locale;
---

<AppLayout title={`DevHub - ${translate(locale, 'page.forgotTitle')}`} description={translate(locale, 'page.forgotSubtitle')} keywords="devhub,auth">
  <ForgotPasswordPage />
</AppLayout>
