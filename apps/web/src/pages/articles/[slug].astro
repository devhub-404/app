---
import { ArticlePage, getArticleBySlugQuery, type ArticleDetails } from '@/features/article/public';
import AppLayout from '@/app/ui/AppLayout.astro';
import { translate as translateI18n } from '@/features/article/i18n';

const locale = Astro.locals.locale;
const t = (key: Parameters<typeof translateI18n>[1], args?: unknown[]) => translateI18n(locale, key, args);

const result = await getArticleBySlugQuery(Astro.params['slug'] ?? '', Astro.locals.api);
const article: ArticleDetails | null = result.item;
if (result.error?.code === 'CONTENT_NOT_FOUND' || (!result.error && !article)) return Astro.redirect('/404');
if (result.error) throw new Error(result.error.code ?? 'ARTICLE_REQUEST_FAILED');
---

<AppLayout
  title={article?.title ?? t('articledetail.devhubArticle')}
  description={article?.description ?? t('articledetail.articleTechnicalDevelopers')}
  author={article?.author ? article.author.displayName || article.author.username : undefined}
  keywords={article?.tags.map((tag) => tag.name).join(',') || 'devhub,article'}
>
  <ArticlePage article={article} failed={false} />
</AppLayout>
