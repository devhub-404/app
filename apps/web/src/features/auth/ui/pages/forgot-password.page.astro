---
import AuthPageComposition from '@/features/auth/ui/components/auth-page-composition.component.astro';
import ForgotPasswordForm from '@/features/auth/ui/components/form/forgot-password-form.component.tsx';
import { translate } from '@/features/auth/i18n';

const locale = Astro.locals.locale;
---

  <AuthPageComposition
    title={translate(locale, 'page.forgotTitle')}
    subtitle={translate(locale, 'page.forgotSubtitle')}
  >
    <ForgotPasswordForm locale={locale} client:load />
  </AuthPageComposition>
