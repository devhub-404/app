---
import AuthPageComposition from '@/features/auth/ui/components/auth-page-composition.component.astro';
import ResetPasswordForm from '@/features/auth/ui/components/form/reset-password-form.component.tsx';
import { translate } from '@/features/auth/i18n';

const locale = Astro.locals.locale;
---

  <AuthPageComposition title={translate(locale, 'page.resetTitle')} subtitle={translate(locale, 'page.resetSubtitle')}>
    <ResetPasswordForm locale={locale} client:load />
  </AuthPageComposition>
