---
import AuthPageComposition from '@/features/auth/ui/components/auth-page-composition.component.astro';
import OAuthCallback from '@/features/auth/ui/components/o-auth-callback.component.tsx';
import { translate } from '@/features/auth/i18n';

const { provider } = Astro.params;
const locale = Astro.locals.locale;
---

  <AuthPageComposition title={translate(locale, 'page.oauthTitle')} subtitle={translate(locale, 'page.oauthSubtitle')}>
    <OAuthCallback provider={provider} locale={locale} client:load />
  </AuthPageComposition>
