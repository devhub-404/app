---
import { CalendarDays, ExternalLink } from 'lucide-solid';
import type { Event } from '@/features/event/types/event.type.ts';
import { routes } from '@/shared/navigation/routes';
import { formatLocalizedDate } from '@/shared/i18n/core';
import { translate as translateI18n } from '@/features/event/i18n';

interface Props {
  event: Event;
}
const { event } = Astro.props;
const locale = Astro.locals.locale;
const t = (key: Parameters<typeof translateI18n>[1]) => translateI18n(locale, key);
const formatDate = (value: string) => formatLocalizedDate(value, locale, { dateStyle: 'medium', timeStyle: 'short' });
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface-elevated p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-action-border hover:shadow-md"
>
  <div
    class="flex items-center justify-between gap-3 text-xs font-semibold uppercase tracking-[.14em] text-content-muted"
  >
    <span class="inline-flex items-center gap-2"
      ><CalendarDays class="size-4 text-content-accent" aria-hidden="true" />{
        event.temporalState === 'ongoing' ? t('events.happeningNow') : t('events.nextEvent')
      }</span
    >
    <span
      >{
        event.format === 'online'
          ? t('events.online')
          : event.format === 'hybrid'
            ? t('events.hybrid')
            : t('events.onsite')
      }</span
    >
  </div>
  <h2 class="heading-card mt-4 text-lg">{event.title}</h2>
  <p class="text-muted-body mt-2 line-clamp-3">{event.description}</p>
  <div class="mt-4 space-y-1 text-sm text-content">
    <p class="text-body">{formatDate(event.startsAt)}</p>
    <p class="text-muted">{t('events.upTo')} {formatDate(event.endsAt)}</p>
    {event.location && <p class="text-muted">{event.location}</p>}
  </div>
  <div class="mt-auto flex items-center justify-between gap-3 border-t border-line pt-4">
    {
      event.url && (
        <a
          href={event.url}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-line px-3 py-2 text-xs font-semibold text-content hover:border-action-border hover:text-content-accent"
        >
          {t('events.siteOfficial')} <ExternalLink class="size-3.5" aria-hidden="true" />
        </a>
      )
    }
    {
      event.slug && (
        <a href={routes.event(event.slug)} class="text-xs font-semibold text-content-accent hover:underline">
          {t('events.viewDetails')}
        </a>
      )
    }
  </div>
</article>
