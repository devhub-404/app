---
export const prerender = false;
import Container from '@/shared/ui/layouts/components/container.component.astro';
import SectionHeader from '@/shared/ui/layouts/components/section-header.component.astro';
import EventsPageContent from '../components/events-page-content.component.astro';
import { translate as translateI18n } from '@/features/event/i18n';

const locale = Astro.locals.locale;
const t = (key: Parameters<typeof translateI18n>[1]) => translateI18n(locale, key);
---

  <SectionHeader
    eyebrow={t('events.agendaTechnical')}
    title={t('eventdetail.events')}
    description={t('eventsindex.discoverConferencesMeetupsWorkshopsOtherEventsRelevantDevelopers')}
  />
  <Container size="full" class="py-8 sm:py-10">
    <EventsPageContent />
  </Container>
