---
import Container from '@/shared/ui/layouts/components/container.component.astro';
import NewQuestion from '../components/new-question.component.tsx';
import BackLink from '@/shared/ui/components/navigation/back-link.component.astro';
import { routes } from '@/shared/navigation/routes';
import { translate as translateI18n } from '@/features/q-and-a/i18n';
---

  <div class="py-6 sm:py-10">
    <Container
      ><div class="mb-6">
        <BackLink href={routes.questions} label={translateI18n(Astro.locals.locale, 'newquestion.q')} />
      </div><NewQuestion locale={Astro.locals.locale} client:load /></Container
    >
  </div>
