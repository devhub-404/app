---
import { ExternalLink, GitBranch } from 'lucide-solid';
import type { Project } from '@/features/project/types/project.type.ts';
import { routes } from '@/shared/navigation/routes';
import ShareButton from '@/shared/ui/components/actions/share-button.component.tsx';
import { translate as translateI18n } from '@/features/project/i18n';
import TagLink from '@/shared/ui/components/navigation/tag-link.component.tsx';

interface Props {
  project: Project;
  view?: 'grid' | 'list';
}
const { project, view = 'grid' } = Astro.props;
const locale = Astro.locals.locale;
const t = (key: Parameters<typeof translateI18n>[1], values?: unknown[]) => translateI18n(locale, key, values);
const orientation = view === 'list' ? 'horizontal' : 'vertical';
---

<article
  class:list={[
    'group h-full overflow-hidden rounded-2xl border border-line bg-surface-elevated shadow-sm transition duration-standard ease-standard hover:-translate-y-0.5 hover:border-action-border hover:shadow-md',
    orientation === 'horizontal'
      ? 'grid grid-cols-[32%_minmax(0,1fr)] max-[700px]:grid-cols-[38%_minmax(0,1fr)]'
      : 'flex flex-col',
  ]}
>
  <div
    class:list={[
      'relative shrink-0 overflow-hidden bg-surface-subtle',
      orientation === 'horizontal' ? 'min-h-32' : 'aspect-[16/9]',
    ]}
  >
    <div class="flex size-full items-center justify-center bg-accent-gradient">
      <GitBranch class="size-10 text-content-accent" aria-hidden="true" />
    </div>
  </div>
  <div class="flex min-w-0 flex-1 flex-col p-4">
    <div class="min-h-5">
      <p class="text-eyebrow">{t('editproject.project')}</p>
      <a href={routes.project(project.slug)}>
        <h2 class="heading-card mt-2 line-clamp-2 text-lg hover:text-content-accent">
          {project.title}
        </h2>
        {
          project.author && (
            <p class="text-caption mt-1 min-h-5">
              {t('projectdetail.by')} {project.author.displayName || project.author.username}
            </p>
          )
        }
        <p class="text-muted-compact mt-1 line-clamp-3">{project.summary}</p>
      </a>
    </div>
    <div class="mt-2 flex flex-wrap gap-2">
      {project.tagSlugs.map((tag) => <TagLink slug={tag} label={tag} />)}
    </div>
    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-line pt-3">
      <div class="flex flex-wrap items-center justify-end gap-2">
        {
          project.projectUrl && (
            <a
              href={project.projectUrl}
              target="_blank"
              rel="noreferrer"
              aria-label={t('projects.openProjectValue0', [project.title])}
              title={t('projects.openProjectValue0', [project.title])}
              class="inline-flex size-9 items-center justify-center rounded-xl border border-line hover:border-action-border"
            >
              <ExternalLink class="size-4" aria-hidden="true" />
            </a>
          )
        }
        {
          project.repositoryUrl && (
            <a
              href={project.repositoryUrl}
              target="_blank"
              rel="noreferrer"
              aria-label={t('projects.openCodeValue0', [project.title])}
              title={t('projects.openCodeValue0', [project.title])}
              class="inline-flex size-9 items-center justify-center rounded-xl border border-line hover:border-action-border"
            >
              <GitBranch class="size-4" aria-hidden="true" />
            </a>
          )
        }
        <ShareButton
          client:idle
          title={project.title}
          url={routes.project(project.slug)}
          label={t('projects.shareValue0', [project.title])}
          copiedLabel={t('projects.linkCopied')}
        />
      </div>
      <a
        href={routes.project(project.slug)}
        class="inline-flex min-h-9 items-center justify-center rounded-lg border border-line bg-surface px-3 text-xs font-semibold text-content transition hover:border-action-border hover:bg-surface-subtle hover:text-content-accent"
        >{t('projects.viewProject')}</a
      >
    </div>
  </div>
</article>
