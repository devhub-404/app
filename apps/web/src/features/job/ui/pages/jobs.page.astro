---
import Container from '@/shared/ui/layouts/components/container.component.astro';
import SectionHeader from '@/shared/ui/layouts/components/section-header.component.astro';
import JobsPageContent from '../components/jobs-page-content.component.astro';
import { translate as translateI18n } from '@/features/job/i18n';

const locale = Astro.locals.locale;
const t = (key: Parameters<typeof translateI18n>[1]) => translateI18n(locale, key);
---

  <SectionHeader
    eyebrow={t('jobsindex.opportunities')}
    title={t('jobmanagement.jobs')}
    description={t('jobsindex.opportunitiesConcreteTemporaryCompensationDeclared')}
  />
  <Container size="full" class="py-8 sm:py-10"><JobsPageContent /></Container>
