---
import SectionHeader from '@/shared/ui/layouts/components/section-header.component.astro';
import Container from '@/shared/ui/layouts/components/container.component.astro';
import BackLink from '@/shared/ui/components/navigation/back-link.component.astro';
import { routes } from '@/shared/navigation/routes';
import NewJob from '../components/new-job.component.tsx';
import { translate as translateI18n } from '@/features/job/i18n';
const locale = Astro.locals.locale;
---

  <SectionHeader
    eyebrow={translateI18n(locale, 'jobmanagement.jobs')}
    title={translateI18n(locale, 'newjob.publishOpportunity')}
    description={translateI18n(locale, 'newjob.describeOpportunityBeforePublishing')}
  >
    <Fragment slot="actions"
      ><BackLink href={routes.jobs} label={translateI18n(locale, 'jobmanagement.jobs')} /></Fragment
    >
  </SectionHeader>
  <div class="py-6 sm:py-8">
    <Container size="sm">
      <NewJob locale={locale} client:load />
    </Container>
  </div>
