---
import type { CollectionEntry } from 'astro:content';
import { translate as translateI18n } from '../../i18n';
import type { Locale } from '@/shared/i18n/core';

interface Props {
  entry: CollectionEntry<'codex'>['data'];
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = (key: Parameters<typeof translateI18n>[1]) => translateI18n(locale, key);
---

<section class="rounded-2xl border border-line bg-surface-elevated p-5 shadow-ui-surface sm:p-6">
  <div class="flex items-start gap-4">
    <div class="grid size-14 shrink-0 place-items-center rounded-2xl bg-surface-subtle p-2 shadow-lg sm:size-16">
      <img src={entry.branding.logo} alt="" class="size-full object-contain" width="96" height="96" />
    </div>
    <div class="min-w-0">
      <h1 class="heading-page">{entry.title}</h1>
      <p class="text-muted-body mt-2 max-w-3xl">{entry.description}</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a
          class="inline-flex items-center rounded-lg border border-line px-3 py-2 text-xs font-semibold text-content-accent hover:bg-surface-subtle"
          href={entry.links.official}
          target="_blank"
          rel="noreferrer"
        >
          {t('codex.official')}
          <span class="ml-1.5" aria-hidden="true">↗</span>
        </a>
        <a
          class="inline-flex items-center rounded-lg border border-line px-3 py-2 text-xs font-semibold text-content-accent hover:bg-surface-subtle"
          href={entry.links.repository}
          target="_blank"
          rel="noreferrer"
        >
          {t('codex.repository')}
          <span class="ml-1.5" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
  {
    entry.metadata.length > 0 && (
      <section class="mt-5 border-t border-line pt-4" aria-labelledby="codex-metadata-title">
        <h2 id="codex-metadata-title" class="heading-tiny-accent text-xs">
          {t('codex.metadata')}
        </h2>
        <dl class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-5">
          {entry.metadata.map((item) => (
            <div class="rounded-xl border border-line bg-surface-subtle px-3 py-2.5">
              <dt class="text-[11px] text-content-muted">{item.label}</dt>
              <dd class="mt-1 truncate text-xs font-medium text-content" title={item.value}>
                {item.value}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</section>
