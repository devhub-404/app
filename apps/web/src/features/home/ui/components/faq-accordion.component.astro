---

export type FaqGroup = {
  title: string;
  items: Array<[question: string, answer: string]>;
};

interface Props {
  groups: FaqGroup[];
}

const { groups } = Astro.props;
---

<div class="grid gap-8">
  {
    groups.map((group) => (
      <section>
        <h2 class="heading-section">
          {group.title}
        </h2>
        <div class="mt-4 grid gap-3">
          {group.items.map(([question, answer]) => (
            <details class="group overflow-hidden rounded-2xl border border-line bg-surface">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-sm font-semibold text-content marker:hidden">
                <span>{question}</span>
                <span
                  class="text-base transition-transform duration-standard ease-standard group-open:rotate-180"
                  aria-hidden="true"
                >
                  ⌄
                </span>
              </summary>
              <div class="px-5 pb-5 text-sm leading-6 text-content-muted">{answer}</div>
            </details>
          ))}
        </div>
      </section>
    ))
  }
</div>
