---
import { translate, type TranslationKey } from '@/features/home/i18n';
const locale = Astro.locals.locale;
const t = (key: TranslationKey) => translate(locale, key);
---

<section class="border-t border-line bg-surface-subtle px-6 py-16 sm:py-20">
  <div class="mx-auto w-full max-w-6xl">
    <div class="max-w-2xl">
      <p class="text-accent-label">
        {t('contribute.qualityEyebrow')}
      </p>
      <h2 class="heading-large-section mt-3">
        {t('contribute.qualityTitle')}
      </h2>
      <p class="text-muted-body mt-4">{t('contribute.qualityDescription')}</p>
    </div>
    <div class="mt-9 grid gap-3 md:grid-cols-3">
      {
        [1, 2, 3].map((number) => (
          <div class="rounded-[16px] border border-line bg-surface p-6">
            <p class="text-accent">0{number}</p>
            <h3 class="heading-card mt-7 text-lg">
              {t(`contribute.quality.${number}.title` as TranslationKey)}
            </h3>
            <p class="text-muted-body mt-3">
              {t(`contribute.quality.${number}.description` as TranslationKey)}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
