---
import { env } from '@/shared/runtime/env';
import { translate, type TranslationKey } from '@/features/home/i18n';
const t = (key: TranslationKey) => translate(Astro.locals.locale, key);
---

<section class="px-6 py-16 sm:py-20">
  <div class="mx-auto grid w-full max-w-6xl gap-6 border-t border-line pt-12 sm:grid-cols-[1fr_auto] sm:items-center">
    <div>
      <p class="text-accent-label">{t('home.supportEyebrow')}</p>
      <h2 class="heading-large-section-compact mt-3">{t('home.supportTitle')}</h2>
      <p class="text-muted-body mt-3 max-w-2xl">{t('home.supportDescription')}</p>
    </div>
    <a href={env.github.sponsorUrl} target="_blank" rel="noreferrer" class="action action-secondary">
      {t('home.supportAction')}
    </a>
  </div>
</section>
