---
import { routes } from '@/shared/navigation/routes';
import { translate, type TranslationKey } from '@/features/home/i18n';
const t = (key: TranslationKey) => translate(Astro.locals.locale, key);
---

<section class="bg-surface-subtle px-6 py-16 sm:py-20">
  <div
    class="mx-auto grid w-full max-w-6xl gap-8 rounded-[22px] border border-action-border bg-selected p-7 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-end"
  >
    <div>
      <p class="text-accent-label">
        {t('home.contributionEyebrow')}
      </p>
      <h2 class="heading-large-section mt-3 max-w-2xl">
        {t('home.contributionTitle')}
      </h2>
      <p class="text-muted-body mt-4 max-w-xl">{t('home.contributionDescription')}</p>
    </div>
    <a href={routes.contribute} class="action action-primary">{t('home.contributionAction')}</a>
  </div>
</section>
