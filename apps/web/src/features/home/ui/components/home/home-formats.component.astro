---
import { routes } from '@/shared/navigation/routes';
import { translate, type TranslationKey } from '@/features/home/i18n';

const t = (key: TranslationKey) => translate(Astro.locals.locale, key);
const formats = [
  ['home.format.articles', 'home.format.articlesDescription', routes.articles],
  ['home.format.codex', 'home.format.codexDescription', routes.codex],
  ['home.format.cheatsheets', 'home.format.cheatsheetsDescription', routes.cheatsheets],
  ['home.format.roadmaps', 'home.format.roadmapsDescription', routes.roadmaps],
  ['home.format.questions', 'home.format.questionsDescription', routes.questions],
  ['home.format.resources', 'home.format.resourcesDescription', routes.resources],
  ['home.format.tools', 'home.format.toolsDescription', routes.tools],
  ['home.format.projects', 'home.format.projectsDescription', routes.projects],
  ['home.format.events', 'home.format.eventsDescription', routes.events],
  ['home.format.jobs', 'home.format.jobsDescription', routes.jobs],
  ['home.format.news', 'home.format.newsDescription', routes.news],
] as const;
---

<section class="px-6 py-16 sm:py-24">
  <div class="mx-auto w-full max-w-6xl">
    <div class="max-w-2xl">
      <p class="text-eyebrow">{t('home.formatsEyebrow')}</p>
      <h2 class="heading-large-section mt-3">{t('home.formatsTitle')}</h2>
      <p class="text-muted-body mt-4">{t('home.formatsDescription')}</p>
    </div>
    <div class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        formats.map(([title, description, href], index) => (
          <a
            href={href}
            class="group rounded-[16px] border border-line bg-surface p-5 transition duration-standard ease-standard hover:-translate-y-1 hover:border-action-border hover:bg-surface-elevated hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus"
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="heading-callout">
                {t(title)}
              </h3>
              <span class="text-xs font-medium text-content-subtle">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <p class="text-muted-body mt-3">
              {t(description)}
            </p>
            <span class="mt-5 block text-xs font-semibold uppercase tracking-[0.16em] text-content-accent">
              {t('home.openFormat')}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
