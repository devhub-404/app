---
import AppLayout from '@/app/ui/AppLayout.astro';
import PublicProfileArticlesPageContent from '@/features/account/ui/components/profile/public-profile-articles-page-content.component.astro';
import { translate as translateI18n } from '@/features/account/i18n';

const username = String(Astro.props['username'] ?? Astro.params['username'] ?? '');
const locale = Astro.locals.locale;
---

<AppLayout
  title={translateI18n(locale, 'publicprofilearticles.pageTitleValue0', [username])}
  description={translateI18n(locale, 'publicprofilearticles.articlesPublishedByUser')}
  keywords={translateI18n(locale, 'publicprofilearticles.metaKeywords')}
>
  <PublicProfileArticlesPageContent username={username} />
</AppLayout>
