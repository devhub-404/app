---
import AccountPageComposition from '@/features/account/ui/components/account-page-composition.component.astro';
import AccountSettings from '@/features/account/ui/components/settings/account-settings.component.tsx';
import EmailSettings from '@/features/account/ui/components/settings/email-settings.component.tsx';
import ProviderSettings from '@/features/account/ui/components/settings/provider-settings.component.tsx';
import PasswordSettings from '@/features/account/ui/components/settings/password-settings.component.tsx';
import SecuritySettings from '@/features/account/ui/components/settings/security-settings.component.tsx';
import PasskeySettings from '@/features/account/ui/components/settings/passkey-settings.component.tsx';
import DangerSettings from '@/features/account/ui/components/settings/danger-settings.component.tsx';
import type { SectionId } from '@/features/account/ui/components/widgets/settings/types.component.ts';

import { translate as translateI18n } from '@/features/account/i18n';
const locale = Astro.locals.locale;
const t = (key: Parameters<typeof translateI18n>[1]) => translateI18n(locale, key);
type Section = Exclude<SectionId, 'profile'>;
type Props = { section: Section };

const { section } = Astro.props;

const copyBySection: Record<Section, { heading: string; subheading: string }> = {
  account: {
    heading: t('accountsettings.accountHeading'),
    subheading: t('accountsettings.accountSubheading'),
  },
  emails: {
    heading: t('accountsettings.emailsHeading'),
    subheading: t('accountsettings.emailsSubheading'),
  },
  providers: {
    heading: t('accountsettings.providersHeading'),
    subheading: t('accountsettings.providersSubheading'),
  },
  password: {
    heading: t('accountsettings.passwordHeading'),
    subheading: t('accountsettings.passwordSubheading'),
  },
  security: {
    heading: t('accountsettings.securityHeading'),
    subheading: t('accountsettings.securitySubheading'),
  },
  passkeys: {
    heading: t('accountsettings.passkeysHeading'),
    subheading: t('accountsettings.passkeysSubheading'),
  },
  danger: {
    heading: t('accountsettings.dangerHeading'),
    subheading: t('accountsettings.dangerSubheading'),
  },
};

const { heading, subheading } = copyBySection[section];
---

  <AccountPageComposition active={section} heading={heading} subheading={subheading}>
    {section === 'account' && <AccountSettings locale={locale} client:load />}
    {section === 'emails' && <EmailSettings locale={locale} client:load />}
    {section === 'providers' && <ProviderSettings locale={locale} client:load />}
    {section === 'password' && <PasswordSettings locale={locale} client:load />}
    {section === 'security' && <SecuritySettings locale={locale} client:load />}
    {section === 'passkeys' && <PasskeySettings locale={locale} client:load />}
    {section === 'danger' && <DangerSettings locale={locale} client:load />}
  </AccountPageComposition>
