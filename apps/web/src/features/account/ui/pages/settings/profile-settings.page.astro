---
import AccountPageComposition from '@/features/account/ui/components/account-page-composition.component.astro';
import ProfileFormCard from '@/features/account/ui/components/profile/profile-form-card.component.tsx';
import { translate as translateI18n } from '@/features/account/i18n';
const locale = Astro.locals.locale;
---

  <AccountPageComposition
    active="profile"
    heading={translateI18n(locale, 'settingspanel.profile')}
    subheading={translateI18n(locale, 'profilesettings.updateNameBioLinksPublic')}
  >
    <ProfileFormCard locale={locale} client:load />
  </AccountPageComposition>
