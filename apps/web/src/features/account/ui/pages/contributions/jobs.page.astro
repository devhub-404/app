---
import { routes } from '@/shared/navigation/routes';
import AccountPageComposition from '@/features/account/ui/components/account-page-composition.component.astro';
import MyJobSuggestions from '@/features/account/ui/components/contributions/my-job-suggestions.component.tsx';
import { translate as translateI18n } from '@/features/account/i18n';
const locale = Astro.locals.locale;
---

  <AccountPageComposition
    active="jobSuggestions"
    heading={translateI18n(locale, 'myjobsuggestions.jobSuggestions')}
    subheading={translateI18n(locale, 'myjobsuggestions.trackSuggestions')}
  >
    <a slot="headerActions" href={routes.jobNew} class="action action-primary"
      >{translateI18n(locale, 'myjobsuggestions.suggestJob')}</a>
    <MyJobSuggestions locale={locale} client:load />
  </AccountPageComposition>
