---
import { AuthPageComposition } from '@/features/auth/public';
import AccountReactivation from '../../components/account-reactivation.component.tsx';
import { translate } from '@/features/account/i18n';
const token = Astro.url.searchParams.get('token') ?? '';
const locale = Astro.locals.locale;
---

  <AuthPageComposition title={translate(locale, 'lifecycle.reactivationMetaTitle')}>
    <AccountReactivation client:load token={token} locale={locale} />
  </AuthPageComposition>
