---
import AccountPageComposition from '@/features/account/ui/components/account-page-composition.component.astro';
import MyCommentsPanel from '@/features/account/ui/components/my-comments-panel.component.tsx';
import { translate as translateI18n } from '@/features/account/i18n';
const locale = Astro.locals.locale;
---

  <AccountPageComposition
    active="comments"
    heading={translateI18n(locale, 'accountcomments.myComments')}
    subheading={translateI18n(locale, 'accountcomments.viewRemoveCommentsPublished')}
  >
    <MyCommentsPanel locale={locale} client:load />
  </AccountPageComposition>
