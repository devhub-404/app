---
import AccountPageComposition from '@/features/account/ui/components/account-page-composition.component.astro';
import BookmarksList from '@/features/account/ui/components/bookmarks/bookmarks-page.component.tsx';
import { translate as translateI18n } from '@/features/account/i18n';
const locale = Astro.locals.locale;
---

  <AccountPageComposition
    active="bookmarks"
    heading={translateI18n(locale, 'bookmarks.bookmarks')}
    subheading={translateI18n(locale, 'bookmarks.libraryPersonalArticlesNewsResourcesQProjectsSaved')}
  >
    <BookmarksList locale={locale} client:load />
  </AccountPageComposition>
