---
import AccountSidebar from './account-sidebar.component.tsx';
import { routes } from '@/shared/navigation/routes';
import { translate, type TranslationKey } from '@/features/account/i18n';
import type { SectionId } from '@/features/account/ui/components/widgets/settings/types.component.ts';
type AccountSection = (typeof groups)[number]['items'][number]['id'] | Exclude<SectionId, 'profile'> | 'media';
interface Props {
  active: AccountSection;
  heading: string;
  subheading: string;
}

const { active, heading, subheading } = Astro.props;
const t = (key: TranslationKey) => translate(Astro.locals.locale, key);
const groups = [
  {
    label: t('accountnav.account'),
    items: [
      { id: 'overview', label: t('accountnav.overview'), href: routes.account.root, icon: 'lucide:layout-dashboard' },
    ],
  },
  {
    label: t('accountnav.profileGroup'),
    items: [
      { id: 'profile', label: t('accountnav.publicData'), href: routes.account.profile, icon: 'lucide:user-round' },
      {
        id: 'preferences',
        label: t('accountnav.preferences'),
        href: routes.account.preferences,
        icon: 'lucide:settings-2',
      },
    ],
  },
  {
    label: t('accountnav.publishedContent'),
    items: [
      { id: 'articles', label: t('accountnav.articles'), href: routes.account.articles, icon: 'lucide:file-text' },
      { id: 'projects', label: t('accountnav.projects'), href: routes.account.projects, icon: 'lucide:folder-kanban' },
      { id: 'jobs', label: t('accountnav.jobs'), href: routes.account.jobs, icon: 'lucide:briefcase-business' },
      {
        id: 'questions',
        label: t('accountnav.questions'),
        href: routes.account.questions,
        icon: 'lucide:circle-question-mark',
      },
      { id: 'answers', label: t('accountnav.answers'), href: routes.account.answers, icon: 'lucide:message-circle' },
    ],
  },
  {
    label: t('accountnav.ecosystem'),
    items: [
      {
        id: 'organizations',
        label: t('accountnav.organizations'),
        href: routes.account.organizations,
        icon: 'lucide:building-2',
      },
    ],
  },
  {
    label: t('accountnav.suggestions'),
    items: [
      {
        id: 'resourceSuggestions',
        label: t('accountnav.resources'),
        href: routes.account.resourceSuggestions,
        icon: 'lucide:link',
      },
      {
        id: 'newsSuggestions',
        label: t('accountnav.newsSuggestions'),
        href: routes.account.newsSuggestions,
        icon: 'lucide:newspaper',
      },
      {
        id: 'eventSuggestions',
        label: t('accountnav.events'),
        href: routes.account.eventSuggestions,
        icon: 'lucide:calendar-days',
      },
      {
        id: 'jobSuggestions',
        label: t('accountnav.jobSuggestions'),
        href: routes.account.jobSuggestions,
        icon: 'lucide:briefcase-business',
      },
    ],
  },
  {
    label: t('accountnav.interactions'),
    items: [
      { id: 'activity', label: t('accountnav.activity'), href: routes.account.activity, icon: 'lucide:clock-3' },
      {
        id: 'notifications',
        label: t('accountnav.notifications'),
        href: routes.account.notifications,
        icon: 'lucide:bell',
      },
      { id: 'votes', label: t('accountnav.votes'), href: routes.account.votes, icon: 'lucide:thumbs-up' },
      { id: 'bookmarks', label: t('accountnav.saved'), href: routes.account.bookmarks, icon: 'lucide:bookmark' },
      { id: 'following', label: t('accountnav.followingTags'), href: routes.account.following, icon: 'lucide:tags' },
      {
        id: 'comments',
        label: t('accountnav.comments'),
        href: routes.account.comments,
        icon: 'lucide:messages-square',
      },
      {
        id: 'views',
        label: t('accountnav.views'),
        href: routes.account.views,
        icon: 'lucide:chart-no-axes-column-increasing',
      },
    ],
  },
  {
    label: t('accountnav.securityAccess'),
    items: [
      { id: 'emails', label: t('accountnav.emails'), href: routes.account.emails, icon: 'lucide:mail' },
      { id: 'password', label: t('accountnav.password'), href: routes.account.password, icon: 'lucide:key-round' },
      {
        id: 'mfa',
        label: t('accountnav.mfa'),
        href: `${routes.account.security}#mfa-totp`,
        icon: 'lucide:shield-check',
      },
      {
        id: 'recoveryCodes',
        label: t('accountnav.recoveryCodes'),
        href: `${routes.account.security}#recovery-codes`,
        icon: 'lucide:life-buoy',
      },
      {
        id: 'passkeys',
        label: t('accountnav.passkeys'),
        href: routes.account.passkeys,
        icon: 'lucide:fingerprint-pattern',
      },
      { id: 'providers', label: t('accountnav.providers'), href: routes.account.providers, icon: 'lucide:link-2' },
      {
        id: 'sessions',
        label: t('accountnav.sessions'),
        href: routes.account.sessions,
        icon: 'lucide:monitor-smartphone',
      },
      { id: 'security', label: t('accountnav.authentication'), href: routes.account.security, icon: 'lucide:shield' },
      {
        id: 'danger',
        label: t('accountnav.accountStatus'),
        href: routes.account.danger,
        icon: 'lucide:triangle-alert',
      },
    ],
  },
] as const;
const navGroups = groups.map((group) => ({
  label: group.label,
  items: group.items.map((item) => ({
    label: item.label,
    href: item.href,
    icon: item.icon,
    active: item.id === active,
  })),
}));
const activeGroup =
  groups.find((group) => group.items.some((item) => item.id === active))?.label ?? t('accountnav.account');
---

<slot name="toast" />
<div class="w-full px-4 py-4 sm:px-6 sm:py-5 lg:px-8">
  <div class="grid gap-4 md:grid-cols-[224px_minmax(0,1fr)] md:items-start lg:grid-cols-[248px_minmax(0,1fr)] lg:gap-5">
    <aside class="min-w-0 md:sticky md:top-[calc(var(--layout-header-height)+1rem)]">
      <AccountSidebar
        client:load
        label={t('accountlayout.sectionsAccount')}
        activeGroup={activeGroup}
        groups={navGroups}
      />
    </aside>
    <div class="min-w-0">
      <section aria-label={heading} class="grid gap-5 sm:gap-6">
        <header class="grid gap-3 border-b border-line pb-5 sm:pb-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
          <div class="grid gap-2">
            <p class="text-eyebrow">{activeGroup}</p>
            <h1 class="heading-page-compact">{heading}</h1>
            <p class="text-muted-body max-w-2xl">{subheading}</p>
          </div>
          {
            Astro.slots.has('headerActions') && (
              <div class="flex flex-wrap items-center gap-2">
                <slot name="headerActions" />
              </div>
            )
          }
        </header>
        <slot />
      </section>
    </div>
  </div>
</div>

