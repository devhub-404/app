---
import { translate as translateI18n } from '@/features/account/i18n';
import ProfileArticles from './profile-articles.component.tsx';
const username = Astro.props['username'] as string;
const locale = Astro.locals.locale;
---

<div>
  <section class="px-6 pb-10 pt-6">
    <div class="mx-auto w-full max-w-4xl">
      <div class="rounded-3xl border border-line bg-surface-subtle p-8 shadow-sm">
        <h1 class="heading-page">
          {translateI18n(locale, 'publicprofilearticles.headingValue0', [username])}
        </h1>
        <p class="text-muted mt-2">
          {translateI18n(locale, 'publicprofilearticles.articlesRecentPublishedThisProfile')}
        </p>
      </div>
    </div>
  </section>
  <div class="px-6 pb-16">
    <div class="mx-auto w-full max-w-4xl">
      <ProfileArticles locale={locale} client:load username={username} />
    </div>
  </div>
</div>

