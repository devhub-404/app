---
import Container from '@/shared/ui/layouts/components/container.component.astro';
import SectionHeader from '@/shared/ui/layouts/components/section-header.component.astro';
import BackLink from '@/shared/ui/components/navigation/back-link.component.astro';
import ResourceSuggestionForm from '../components/suggestion/resource-suggestion-form.component.tsx';
import { routes } from '@/shared/navigation/routes';
import { translate } from '@/features/resource/i18n';
const locale = Astro.locals.locale;
---

  <SectionHeader
    title={translate(locale, 'resourcesuggestionpage.heading')}
    description={translate(locale, 'resourcesuggestionpage.description')}
  />
  <div class="py-6 sm:py-8">
    <Container size="sm">
      <div class="grid gap-5">
        <BackLink href={routes.resources} label={translate(locale, 'resourcesuggestionpage.back')} />
        <ResourceSuggestionForm client:load locale={locale} />
      </div>
    </Container>
  </div>
