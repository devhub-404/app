---
import PanelPageComposition from '@/features/panel/ui/components/panel-page-composition.component.astro';
import ResourceSuggestionsAdminList from '@/features/panel/ui/components/resource-suggestions-admin-list.component.tsx';
import { translate as translateI18n } from '@/features/panel/i18n';
const locale = Astro.locals.locale;
---

  <PanelPageComposition
    active="resource-suggestions"
    heading={translateI18n(locale, 'panelresourceSuggestions.heading')}
    subheading={translateI18n(locale, 'panelresourceSuggestions.subheading')}
  >
    <ResourceSuggestionsAdminList locale={locale} client:load />
  </PanelPageComposition>
