---
import PanelPageComposition from '@/features/panel/ui/components/panel-page-composition.component.astro';
import HiddenContentList from '@/features/panel/ui/components/hidden-content-list.component.tsx';
import { translate as translateI18n } from '@/features/panel/i18n';
const locale = Astro.locals.locale;
---

  <PanelPageComposition
    active="hidden-content"
    heading={translateI18n(locale, 'hiddencontent.title')}
    subheading={translateI18n(locale, 'hiddencontent.description')}
  >
    <HiddenContentList locale={locale} client:load />
  </PanelPageComposition>
