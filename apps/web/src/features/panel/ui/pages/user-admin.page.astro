---
import PanelPageComposition from '@/features/panel/ui/components/panel-page-composition.component.astro';
import UserAdminDetail from '@/features/panel/ui/components/user-admin-detail.component.tsx';

import { translate as translateI18n } from '@/features/panel/i18n';
const { id } = Astro.params;
const locale = Astro.locals.locale;
---

  <PanelPageComposition
    active="inventory"
    heading={translateI18n(locale, 'paneluserdetail.user')}
    subheading={translateI18n(locale, 'paneluserdetail.reviewDataUser')}
  >
    <UserAdminDetail locale={locale} client:load id={id ?? ''} />
  </PanelPageComposition>
