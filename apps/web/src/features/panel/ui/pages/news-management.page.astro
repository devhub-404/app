---
import PanelPageComposition from '@/features/panel/ui/components/panel-page-composition.component.astro';
import NewsManagement from '@/features/panel/ui/components/news-management.component.tsx';
import { translate as translateI18n } from '@/features/panel/i18n';
const locale = Astro.locals.locale;
---

  <PanelPageComposition
    active="news"
    heading={translateI18n(locale, 'panelnews.newsEditorial')}
    subheading={translateI18n(locale, 'panelnews.trackFlowPublicationReviewSuggestionsMaintainSourcesEcosystem')}
  >
    <Fragment slot="headerActions">
      <a href="/news/new" class="action action-primary">{translateI18n(locale, 'panelnews.newNews')}</a>
    </Fragment>
    <NewsManagement locale={locale} client:load />
  </PanelPageComposition>
