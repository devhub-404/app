---
import PanelPageComposition from '@/features/panel/ui/components/panel-page-composition.component.astro';
import UsersList from '@/features/panel/ui/components/users-list.component.tsx';
import { translate as translateI18n } from '@/features/panel/i18n';
const locale = Astro.locals.locale;
---

  <PanelPageComposition
    active="inventory"
    heading={translateI18n(locale, 'panelusers.users')}
    subheading={translateI18n(locale, 'panelusers.trackUsersActive')}
  >
    <UsersList locale={locale} client:load />
  </PanelPageComposition>
