---
import PanelPageComposition from '@/features/panel/ui/components/panel-page-composition.component.astro';
import AdminOverview from '@/features/panel/ui/components/admin-overview.component.astro';
import { translate as translateI18n } from '@/features/panel/i18n';
const locale = Astro.locals.locale;
---

  <PanelPageComposition
    active="overview"
    heading={translateI18n(locale, 'panellayout.management')}
    subheading={translateI18n(locale, 'panelindex.accessAreasCompatibleResponsibilitiesPlatform')}
  >
    <AdminOverview />
  </PanelPageComposition>
