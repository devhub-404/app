---
import PanelPageComposition from '@/features/panel/ui/components/panel-page-composition.component.astro';
import NewsSuggestionsAdminList from '@/features/panel/ui/components/news-suggestions-admin-list.component.tsx';
import { translate as translateI18n } from '@/features/panel/i18n';
const locale = Astro.locals.locale;
---

  <PanelPageComposition
    active="news-suggestions"
    heading={translateI18n(locale, 'panelnewsSuggestions.heading')}
    subheading={translateI18n(locale, 'panelnewsSuggestions.subheading')}
  >
    <NewsSuggestionsAdminList locale={locale} client:load />
  </PanelPageComposition>
