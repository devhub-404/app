---
import PanelPageComposition from '@/features/panel/ui/components/panel-page-composition.component.astro';
import EventSuggestionsAdminList from '@/features/panel/ui/components/event-suggestions-admin-list.component.tsx';
import { translate as translateI18n } from '@/features/panel/i18n';
const locale = Astro.locals.locale;
---

  <PanelPageComposition
    active="event-suggestions"
    heading={translateI18n(locale, 'eventsuggestions.title')}
    subheading={translateI18n(locale, 'eventsuggestions.description')}
  >
    <EventSuggestionsAdminList locale={locale} client:load />
  </PanelPageComposition>
